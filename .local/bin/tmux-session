#!/usr/bin/env bash

# ==============================================================================
# tmux-session — Global tmux session manager
# ==============================================================================
# Usage:
#   tmux-session              # nvim → bash (default)
#   tmux-session --basic      # git → ai → nvim → files → bash (-gan)
#   tmux-session --web        # web mode: git → web(left/right) → build → test → debug → ai → nvim → files → bash
#   tmux-session --compile    # compile mode: git → build → test → debug → ai → nvim → files → bash
#   tmux-session -gbtdan      # stackable short flags (order doesn't matter)
#   tmux-session --web -v     # combine mode with extra short flags
# ==============================================================================

# Check if tmux is installed
command -v tmux >/dev/null 2>&1 || { echo "Error: tmux is not installed." >&2; exit 1; }

# Session name from PWD
SESSION=$(basename "$PWD" | tr '.' '-')

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
CHEAT_DIR="$SCRIPT_DIR/tmux-session.d"

# ==============================================================================
# Mode flags (mutually exclusive)
# ==============================================================================
MODE=""  # "web", "compile", or "basic"

# Short flags (stackable, any order)
HAS_GIT=false
HAS_DOCKER=false
HAS_BUILD=false
HAS_TEST=false
HAS_DEBUG=false
HAS_AI=false
HAS_FILES=false
HAS_NVIM=false

# Parse flags
while [[ $# -gt 0 ]]; do
    case $1 in
        --web)
            if [ -n "$MODE" ]; then
                echo "Error: Cannot use --web with $MODE. Use --web, --compile, or --basic (not combined)." >&2
                exit 1
            fi
            MODE="web"
            shift
            ;;
        --compile)
            if [ -n "$MODE" ]; then
                echo "Error: Cannot use --compile with $MODE. Use --web, --compile, or --basic (not combined)." >&2
                exit 1
            fi
            MODE="compile"
            shift
            ;;
        --basic)
            if [ -n "$MODE" ]; then
                echo "Error: Cannot use --basic with $MODE. Use --basic for minimal setup, or --web/--compile for full mode." >&2
                exit 1
            fi
            if $HAS_BUILD || $HAS_TEST || $HAS_DEBUG; then
                echo "Error: Cannot use --basic with -b/-t/-d. Use --web or --compile if you need build/test/debug." >&2
                exit 1
            fi
            MODE="basic"
            HAS_GIT=true
            HAS_AI=true
            HAS_FILES=true
            HAS_NVIM=true
            shift
            ;;
        -g)
            HAS_GIT=true
            shift
            ;;
        -v)
            HAS_DOCKER=true
            shift
            ;;
        -b)
            HAS_BUILD=true
            shift
            ;;
        -t)
            HAS_TEST=true
            shift
            ;;
        -d)
            HAS_DEBUG=true
            shift
            ;;
        -a)
            HAS_AI=true
            shift
            ;;
        -f)
            HAS_FILES=true
            shift
            ;;
        -n)
            HAS_NVIM=true
            shift
            ;;
        *)
            shift
            ;;
    esac
done

# Validate: -b/-t/-d require a mode
if ($HAS_BUILD || $HAS_TEST || $HAS_DEBUG) && [ -z "$MODE" ]; then
    echo "Error: Build/test/debug (-b/-t/-d) require a mode: --web or --compile" >&2
    exit 1
fi

# Apply --basic defaults (--basic = -gan)
if [ "$MODE" = "basic" ]; then
    HAS_GIT=true
    HAS_AI=true
    HAS_NVIM=true
fi

# Apply --web defaults
if [ "$MODE" = "web" ]; then
    HAS_GIT=true
    HAS_BUILD=true
    HAS_TEST=true
    HAS_DEBUG=true
    HAS_AI=true
    HAS_FILES=true
    HAS_NVIM=true
fi

# Apply --compile defaults
if [ "$MODE" = "compile" ]; then
    HAS_GIT=true
    HAS_BUILD=true
    HAS_TEST=true
    HAS_DEBUG=true
    HAS_AI=true
    HAS_FILES=true
    HAS_NVIM=true
fi

# Apply defaults for no mode (tmux-session = -n)
if [ -z "$MODE" ]; then
    HAS_NVIM=true
fi

# Check if session already exists
if tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux attach-session -t "$SESSION"
    exit 0
fi

# ==============================================================================
# Window queue (created in order; bash is always appended last)
# ==============================================================================
WINDOWS=()  # entries: "name|command|execute"

add_window() {
    WINDOWS+=("$1|$2|$3")
}

# ==============================================================================
# Detect web package manager
# ==============================================================================
detect_web_pkg_manager() {
    if [ -f "pnpm-lock.yaml" ]; then
        echo "pnpm"
    elif [ -f "package-lock.json" ]; then
        echo "npm"
    elif [ -f "bun.lockb" ]; then
        echo "bun"
    else
        echo "pnpm"  # default
    fi
}



# ==============================================================================
# Queue windows in fixed order (bash always appended last)
# ==============================================================================

# 1. git
if $HAS_GIT; then
    add_window "git" "lazygit" "yes"
fi

# 2. docker (if -v flag)
if $HAS_DOCKER; then
    add_window "docker" "lazydocker" "yes"
fi

# 3. web (web mode only: single window with two panes)
if [ "$MODE" = "web" ]; then
    add_window "web" "" "split"
fi

# 4. build
if $HAS_BUILD; then
    if [ "$MODE" = "web" ]; then
        add_window "build" "$CHEAT_DIR/web-build.txt" "cheatsheet"
    elif [ "$MODE" = "compile" ]; then
        add_window "build" "$CHEAT_DIR/compile-build.txt" "cheatsheet"
    else
        add_window "build" "make" "no"
    fi
fi

# 5. test
if $HAS_TEST; then
    if [ "$MODE" = "web" ]; then
        add_window "test" "$CHEAT_DIR/web-test.txt" "cheatsheet"
    elif [ "$MODE" = "compile" ]; then
        add_window "test" "$CHEAT_DIR/compile-test.txt" "cheatsheet"
    else
        add_window "test" "make test" "no"
    fi
fi

# 6. debug
if $HAS_DEBUG; then
    if [ "$MODE" = "web" ]; then
        add_window "debug" "$CHEAT_DIR/web-debug.txt" "cheatsheet"
    elif [ "$MODE" = "compile" ]; then
        add_window "debug" "$CHEAT_DIR/compile-debug.txt" "cheatsheet"
    else
        add_window "debug" "gdb ./a.out" "no"
    fi
fi

# 7. ai
if $HAS_AI; then
    add_window "ai" "pi" "no"
fi

# 8. nvim
if $HAS_NVIM; then
    add_window "nvim" "nvim" "yes"
fi

# 9. files
if $HAS_FILES; then
    add_window "files" "yazi" "yes"
fi

# 10. bash (always last)
add_window "bash" "" ""

# ==============================================================================
# Create the session in final order (no reordering needed)
# ==============================================================================
for _i in "${!WINDOWS[@]}"; do
    IFS='|' read -r _wname _wcmd _wexec <<< "${WINDOWS[$_i]}"

    if [ "$_i" -eq 0 ]; then
        tmux new-session -d -s "$SESSION" -n "$_wname" -c "$PWD"
    else
        tmux new-window -d -t "$SESSION" -n "$_wname" -c "$PWD"
    fi

    # Cheatsheet: display a static file with cat
    if [ -f "$_wcmd" ]; then
        tmux send-keys -t "$SESSION:$_wname" "cat \"$_wcmd\"" C-m
    # Execute a command (send-keys + C-m)
    elif [ "$_wexec" = "yes" ]; then
        tmux send-keys -t "$SESSION:$_wname" "$_wcmd" C-m
    # Prefill a command (send-keys without C-m)
    elif [ -n "$_wcmd" ]; then
        tmux send-keys -t "$SESSION:$_wname" "$_wcmd"
    fi

    # Special handling for web (two-pane split window)
    if [ "$_wname" = "web" ]; then
        tmux send-keys -t "$SESSION:$_wname.1" "cat \"$CHEAT_DIR/web-backend.txt\"" C-m

        # Split horizontally (left/right panes)
        tmux split-window -h -t "$SESSION:$_wname.1"

        tmux send-keys -t "$SESSION:$_wname.2" "cat \"$CHEAT_DIR/web-frontend.txt\"" C-m
    fi
done

# Attach (session stays on the first window)
tmux attach-session -t "$SESSION"
