# Git configuration for the `git release` fast-forward workflow.
#
# Installed GLOBALLY on each machine (not per repo) by copying this file to:
#   ~/.config/git/release.gitconfig
# and then running:
#   git config --global include.path ~/.config/git/release.gitconfig
#
# Branch names resolve per repo (highest precedence first):
#   GIT_RELEASE_PRODUCTION / GIT_RELEASE_STAGING  (env)
#   git config release.production / release.staging  (local > global)
#   defaults: main / staging
#
# The release bypass key lives in ~/.config/git/release-key (0600) or the
# GIT_RELEASE_KEY env var. `git release` reads it automatically.

[alias]
    # Fast-forward `staging` into `production` locally, then push. The hook
    # (core.hooksPath) permits the direct production push because the alias
    # supplies the release auth key.
    #
    # release.sh is expected at <release.libdir>/release.sh.
    # Default (~/.config/git/hooks) is where you copy this repo's `hooks/` dir
    # on the machine; override release.libdir if you place it elsewhere.
    # Usage:
    #   git release            -> fetch, fast-forward staging into production, push
    #   git release --continue -> resume after an interrupted release that already
    #                             merged locally but could not push. Pushes the
    #                             already-merged production branch without re-merging.
    #
    # Idempotency / safety: the alias NEVER force-resets or overwrites local
    # commits on the production branch. If local production has commits not yet
    # on origin, it aborts rather than guessing (this protects manual fixes made
    # after a partial/aborted release). Use `git release --continue` only when
    # the local commits are the intended release merge from an interrupted push.
    release = "!f() { SCRIPT_DIR=$(git config release.libdir || printf '%s' \"$HOME/.config/git/hooks\"); . \"$SCRIPT_DIR/release.sh\" \"$@\"; }; f"
